# ─── APPLICATION ──────────────────────────────────────────
# Base URL for the application (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example: NEXT_PUBLIC_SITE_URL=https://rentme.ug

# ─── AUTHENTICATION ───────────────────────────────────────
# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
# Required in production for stable cookies/CSRF
NEXTAUTH_URL=http://localhost:3000
# Legacy JWT secret (NEXTAUTH_SECRET takes precedence)
# JWT_SECRET=your-jwt-secret-here

# ─── DATABASE ─────────────────────────────────────────────
# Local / Vercel: full connection string
DATABASE_URL=postgresql://rentme:rentme_password@localhost:5432/rentme?schema=public

# Docker Compose production variables (used by docker-compose.yml)
POSTGRES_USER=rentme
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rentme

# ─── OBJECT STORAGE (Cloudflare R2 — existing RentMe uploads) ─
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_S3_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# S3_API=https://pub-<hash>.r2.dev
# NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── MEMORY CACHE (free, in-process — no Redis / no signup) ───
# CACHE_MAX_ENTRIES=500
# CACHE_TTL_MS=60000
# CACHE_PROPERTIES_TTL_MS=45000
# CACHE_PROPERTY_DETAIL_TTL_MS=60000
# CACHE_AUTH_USER_TTL_MS=30000

# ─── CRON JOBS ────────────────────────────────────────────
# Secret for authenticating cron job requests (generate with: openssl rand -base64 32)
# Used by: /api/cron/rent-reminders
CRON_SECRET=your-cron-secret-here

# ─── SUPPORT CHATBOT (optional — Stage 7) ─────────────────
# Server-only upstream assistant for POST /api/chatbot/message.
# NEVER prefix these with NEXT_PUBLIC_ (keys must stay off the client bundle).
# When unset, the chatbot falls back to the built-in rule-based engine.
# CHATBOT_PROXY_URL=https://assistant.example.com/v1/message
# CHATBOT_PROXY_API_KEY=your-upstream-api-key

# ─── SMTP / EMAIL (optional) ──────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@rentme.ug

# ─── REDIS ────────────────────────────────────────────────
# Not used by the current RentMe application (NextAuth JWT).
# Do not add a Redis service unless application code requires it.

# ─── K3S / KUBERNETES ─────────────────────────────────────
# Primary production orchestrator. See k8s/ and make k3s-* targets.
# RENTME_NAMESPACE=rentme
# RENTME_IMAGE_REPO=ghcr.io/aidomex-group-ltd/rentme
# RENTME_IMAGE_TAG=latest
# PROD_DOMAIN=rentme.ug
# KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# GHCR_USER=your-github-username
# GHCR_TOKEN=ghp_xxx   # read:packages — used by make k3s-registry
# GHCR_EMAIL=you@users.noreply.github.com

# ─── DOCKER COMPOSE (optional lab / single-node) ──────────
# RENTME_IMAGE=rentme:local
# POSTGRES_USER=rentme
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=rentme
