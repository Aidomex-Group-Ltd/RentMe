# ─── Database (REQUIRED for auth, listings, messages) ───
# Cloudflare R2 is file/object storage — it cannot replace this.
# Use Neon, Supabase, Vercel Postgres, Railway, etc.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── NextAuth (REQUIRED for login/register sessions) ───
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Must match the public site URL (e.g. https://rent-me-seven.vercel.app).
# If omitted, the app falls back to NEXT_PUBLIC_SITE_URL / VERCEL_URL.
NEXTAUTH_URL="https://your-production-domain.vercel.app"
NEXT_PUBLIC_SITE_URL="https://your-production-domain.vercel.app"

# ─── Cloudflare R2 (object storage for photos/files only) ───
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_S3_ACCESS_KEY_ID=""
CLOUDFLARE_S3_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_API=""
JWT_SECRET=""
