# ─── APPLICATION ──────────────────────────────────────────
# Base URL for the application (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── AUTHENTICATION ───────────────────────────────────────
# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
# NextAuth URL (auto-derived from NEXT_PUBLIC_SITE_URL if not set)
# NEXTAUTH_URL=http://localhost:3000
# Legacy JWT secret (NEXTAUTH_SECRET takes precedence)
# JWT_SECRET=your-jwt-secret-here

# ─── DATABASE ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://rentme:rentme_password@localhost:5432/rentme?schema=public

# ─── REDIS (optional - for session/cache in production) ───
# REDIS_URL=redis://:redis_password@localhost:6379

# ─── CLOUDFLARE R2 (object storage for uploads) ───────────
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_S3_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
# Public URL for serving uploaded files
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
# Alternative public URL env var
# S3_API=https://pub-<hash>.r2.dev
# NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ─── SMTP / EMAIL (optional) ──────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@rentme.ug

# ─── PRODUCTION DATABASE (set in deployment environment) ──
# For Docker Compose, these are set in docker-compose.yml
# For Vercel, set in Project Settings > Environment Variables
# DATABASE_URL=postgresql://rentme:strong_password_here@db:5432/rentme?schema=public
# NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
